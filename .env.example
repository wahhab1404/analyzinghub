# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# API Keys
POLYGON_API_KEY=your_polygon_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_SECRET=your_webhook_secret_here

# App Base URL
APP_BASE_URL=https://analyzhub.com

# Email Configuration (ZeptoMail/Zoho)
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=emailapikey
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@analyzhub.com
SMTP_FROM_NAME=AnalyzingHub

# OpenAI Configuration (required for AI analysis features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# Twitter (X) Integration — per-analyst trade announcements
# Create an OAuth 2.0 "Web App" client in the X Developer Portal and set the
# callback to <APP_BASE_URL>/api/twitter/callback. TWITTER_TOKEN_ENC_KEY is any
# long random secret used to encrypt stored analyst tokens (AES-256-GCM).
TWITTER_CLIENT_ID=your_twitter_oauth2_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_oauth2_client_secret_here
TWITTER_REDIRECT_URI=https://analyzhub.com/api/twitter/callback
TWITTER_TOKEN_ENC_KEY=your_long_random_encryption_secret_here
